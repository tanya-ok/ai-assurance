{
  "schema": 1,
  "scope": "synthetic-healthcare-local-v1",
  "interpretation": "independently-authored-engineering-subset",
  "requirements": [
    {
      "id": "local-resource-grants",
      "area": "security",
      "source": "https://www.hhs.gov/hipaa/for-professionals/security/laws-regulations/index.html",
      "scenarios": ["authorized-read", "cross-resource-read", "read-only-session", "unknown-tool", "malformed-proposal"],
      "limit": "Local tool/resource policy only; actor authentication is not tested."
    },
    {
      "id": "local-data-boundary",
      "area": "security",
      "source": "https://www.hhs.gov/hipaa/for-professionals/privacy/guidance/minimum-necessary-requirement/index.html",
      "scenarios": ["authorized-read", "private-field-read", "external-export"],
      "limit": "Authored field policy on synthetic data, not a determination of minimum-necessary applicability."
    },
    {
      "id": "local-action-authority",
      "area": "ai-safety",
      "source": "https://blog.bluedot.org/p/ai-control",
      "scenarios": ["approved-write", "unapproved-write", "self-claimed-approval", "retrieved-permission", "approval-target-swap", "approval-value-swap", "approval-replay", "cancelled-session"],
      "limit": "Exact host-owned fixture authorization in one local session, not a validated approval service."
    },
    {
      "id": "organizational-risk-analysis",
      "area": "compliance-evidence",
      "source": "https://www.hhs.gov/hipaa/for-professionals/security/laws-regulations/index.html",
      "scenarios": [],
      "limit": "No organizational risk assessment or authorized review is supplied."
    },
    {
      "id": "provider-agreements",
      "area": "compliance-evidence",
      "source": "https://www.hhs.gov/hipaa/for-professionals/special-topics/health-information-technology/cloud-computing/index.html",
      "scenarios": [],
      "limit": "No provider inventory, business-associate applicability decision or executed BAA is supplied."
    },
    {
      "id": "identity-and-transmission",
      "area": "security",
      "source": "https://www.hhs.gov/hipaa/for-professionals/security/laws-regulations/index.html",
      "scenarios": [],
      "limit": "Offline in-memory fixture has no identity provider, TLS endpoint or production configuration."
    },
    {
      "id": "durable-audit-and-recovery",
      "area": "security",
      "source": "https://www.hhs.gov/hipaa/for-professionals/security/laws-regulations/index.html",
      "scenarios": [],
      "limit": "Payload-free events are not durable audit storage, integrity protection or tested recovery."
    },
    {
      "id": "model-behavior-evaluation",
      "area": "ai-safety",
      "source": "https://bluedot.org/courses/technical-ai-safety/3/1",
      "scenarios": [],
      "limit": "No model execution, repeated trials or held-out attack set."
    }
  ]
